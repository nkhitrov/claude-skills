#!/usr/bin/env bash
# Per-worktree environment: unique DB name + free ports, stored in .env.worktree.
# Usage: bin/wt setup | teardown | env | status
# Template from ~/.claude/skills/worktree-setup — adapt the CONFIG block and the
# install_deps / migrate hooks to the project. Bash 3.2 compatible (macOS).

set -euo pipefail

# ---------- CONFIG (adapt) ----------
PROJECT="${WT_PROJECT:-myapp}"                 # prefix for DB names
PORT_VARS="${WT_PORT_VARS:-APP_PORT}"          # env vars that need a free port each, space separated
PORT_RANGE_START="${WT_PORT_RANGE_START:-20000}"
PORT_RANGE_SIZE="${WT_PORT_RANGE_SIZE:-20000}"
# Admin connection to the ONE shared DBMS (not per worktree).
DB_ADMIN_URL="${WT_DB_ADMIN_URL:-postgres://postgres:postgres@localhost:5432/postgres}"
ENV_FILE=".env.worktree"

install_deps() {
  # e.g.: pnpm install --frozen-lockfile  |  uv sync  |  bundle install
  :
}
migrate() {
  # e.g.: pnpm db:migrate  |  uv run alembic upgrade head  |  bin/rails db:prepare
  :
}
# ------------------------------------

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

slug() { basename "$ROOT" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9\n' '_' | cut -c1-40; }

is_main_checkout() { [ "$(git rev-parse --git-dir)" = "$(git rev-parse --git-common-dir)" ]; }

db_name() {
  if is_main_checkout; then echo "${PROJECT}_dev"; else echo "${PROJECT}_wt_$(slug)"; fi
}

port_busy() {
  local p="$1"
  if command -v lsof >/dev/null 2>&1; then
    lsof -nP -iTCP:"$p" -sTCP:LISTEN >/dev/null 2>&1
  else
    (echo >"/dev/tcp/127.0.0.1/$p") >/dev/null 2>&1
  fi
}

# Ports already handed out to other worktrees (they may be stopped right now).
claimed_ports() {
  git worktree list --porcelain | sed -n 's/^worktree //p' | while read -r wt; do
    [ "$wt" = "$ROOT" ] && continue
    if [ -f "$wt/$ENV_FILE" ]; then sed -n 's/^[A-Z_]*PORT=//p' "$wt/$ENV_FILE"; fi
  done
}

pick_port() {
  local claimed="$1" taken="$2" p tries=0
  # Deterministic start per worktree path, so restarts usually get the same port.
  p=$(( PORT_RANGE_START + $(printf '%s' "$ROOT" | cksum | cut -d' ' -f1) % PORT_RANGE_SIZE ))
  while :; do
    case " $claimed $taken " in *" $p "*) ;; *) port_busy "$p" || { echo "$p"; return; } ;; esac
    p=$(( p + 1 )); tries=$(( tries + 1 ))
    [ "$p" -ge $(( PORT_RANGE_START + PORT_RANGE_SIZE )) ] && p="$PORT_RANGE_START"
    [ "$tries" -gt 2000 ] && { echo "wt: no free port found" >&2; exit 1; }
  done
}

write_env() {
  if [ -f "$ENV_FILE" ]; then return; fi
  local claimed taken="" var p
  claimed="$(claimed_ports | tr '\n' ' ')"
  {
    echo "# generated by bin/wt — per-worktree values, do not commit"
    echo "WT_NAME=$(slug)"
    echo "DB_NAME=$(db_name)"
    for var in $PORT_VARS; do
      p="$(pick_port "$claimed" "$taken")"; taken="$taken $p"
      echo "$var=$p"
    done
  } >"$ENV_FILE"
}

psql_admin() { psql "$DB_ADMIN_URL" -v ON_ERROR_STOP=1 -qtAc "$1"; }

create_db() {
  local db; db="$(db_name)"
  if [ "$(psql_admin "SELECT 1 FROM pg_database WHERE datname='$db'")" != 1 ]; then
    psql_admin "CREATE DATABASE \"$db\""
    echo "wt: created database $db"
  fi
}

drop_db() {
  local db; db="$(db_name)"
  is_main_checkout && { echo "wt: refusing to drop the main checkout database" >&2; return; }
  psql_admin "DROP DATABASE IF EXISTS \"$db\" WITH (FORCE)"
  echo "wt: dropped database $db"
}

case "${1:-}" in
  setup)
    [ -f .env ] || { [ -f .env.example ] && cp .env.example .env; }
    write_env
    install_deps
    create_db
    set -a; . "./$ENV_FILE"; set +a
    migrate
    cat "$ENV_FILE"
    ;;
  teardown)
    drop_db
    rm -f "$ENV_FILE"
    ;;
  env)
    write_env
    cat "$ENV_FILE"
    ;;
  status)
    echo "worktree: $ROOT ($(is_main_checkout && echo main || echo linked))"
    [ -f "$ENV_FILE" ] && cat "$ENV_FILE" || echo "no $ENV_FILE yet — run: bin/wt setup"
    ;;
  *)
    echo "usage: bin/wt setup|teardown|env|status" >&2; exit 2 ;;
esac
